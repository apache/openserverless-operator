!kubectl -n openserverless delete all --all
!kubectl -n openserverless delete pvc --all

import openserverless.config as cfg
import openserverless.ferretdb as mdb
import openserverless.kube as kube
import openserverless.util as util
import openserverless.postgres_operator as postgres
import openserverless.testutil as tu
from openserverless.user_config import UserConfig
from openserverless.user_metadata import UserMetadata

# test
assert(cfg.configure(tu.load_sample_config()))
cfg.detect_storage()
assert(postgres.create())
assert(mdb.create())

while not kube.wait("pod/openserverless-mongodb-0", "condition=ready"): pass

assert(kube.get("service/openserverless-mongodb-svc"))
assert(kube.kubectl("get", f"cm/config", jsonpath="{.metadata.annotations.mongodb_url}"))

# user provisioning: ferretdb backs the mongodb.* user configuration on postgres
spec = tu.load_sample_config("whisk-user")
assert(spec)

ucfg = UserConfig(spec)
udata = UserMetadata(ucfg)

assert(mdb.create_db_user(ucfg, udata))
assert(any(e['key'] == "MONGODB_URL" for e in udata.get_metadata()['metadata']))

# Prove provisioning created the intended database and login grants, rather than merely
# returning psql output. Keep credentials inside the database pod environment.
primary = util.get_pod_name_by_selector("app=openserverless-postgres", "{.items[?(@.metadata.labels.replicationRole == 'primary')].metadata.name}")
assert(primary)

def scalar(query):
    return kube.kubectl("exec", primary, "--", "sh", "-c",
        'PGPASSWORD="$POSTGRES_PASSWORD" exec psql --no-psqlrc --username=postgres --dbname=postgres --tuples-only --no-align --set=ON_ERROR_STOP=1 --command "$1"',
        "ferretdb-probe", query).strip()

database = (ucfg.get('mongodb.database') + '_ferretdb').replace("'", "''")
username = (ucfg.get('namespace') + '_ferretdb').replace("'", "''")
assert(scalar(f"SELECT count(*) FROM pg_database d, pg_roles r WHERE d.datname='{database}' AND r.rolname='{username}' AND r.rolcanlogin AND has_database_privilege(r.oid,d.oid,'CONNECT') AND has_database_privilege(r.oid,d.oid,'CREATE')") == '1')
assert(mdb.delete_db_user(ucfg.get('namespace'),ucfg.get('mongodb.database')))
assert(scalar(f"SELECT ((EXISTS(SELECT 1 FROM pg_database WHERE datname='{database}')) OR (EXISTS(SELECT 1 FROM pg_roles WHERE rolname='{username}')))::int") == '0')

assert(mdb.delete())
assert(postgres.delete())

!kubectl -n openserverless delete all --all
!kubectl -n openserverless delete pvc --all
