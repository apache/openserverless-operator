import openserverless.couchdb as cdb
import openserverless.couchdb_util as cdbu
import openserverless.testutil as tu
import openserverless.config as cfg
import openserverless.kube as kube
import openserverless.testutil as tu
import time
from kopf.testing import KopfRunner

tu.run_proc("kubectl -n openserverless delete all --all")
tu.run_proc("kubectl -n openserverless delete pvc --all")


assert(cfg.configure(tu.load_sample_config()))
assert(cfg.detect_labels()["openserverless.kube"] == "kind")
assert(cfg.detect_storage()["openserverless.storageclass"] == "standard")
assert(cfg.put("couchdb.host", "localhost"))

tu.run_proc("kubectl apply -f tests/kind/whisk.yaml")
wsk = kube.get("wsk/controller")
cdb.create(wsk)

import openserverless.couchdb_util
db = openserverless.couchdb_util.CouchDB()

assert(db.wait_db_ready(60))
assert(db.configure_single_node())
assert(db.configure_no_reduce_limit())

assert(cdb.init_system(db))
assert(cdb.init_subjects(db))
assert(cdb.init_activations(db))
assert(cdb.init_actions(db))
assert(cdb.add_initial_subjects(db))

with KopfRunner(['run', '-A', '--verbose', 'openserverless/user_handlers.py']) as runner:
    # do something while the operator is running.
    tu.run_proc("kubectl apply -f tests/whisk-user.yaml")
    time.sleep(1)  # give it some time to react and to sleep and to retry
    wsku = kube.get("wsku/franztt")    
    assert(wsku['spec'])

    tu.run_proc("kubectl delete -f tests/whisk-user.yaml")
    time.sleep(1)  # give it some time to react

assert runner.exit_code == 0
assert runner.exception is None

tu.run_proc("kubectl -n openserverless delete all --all")
tu.run_proc("kubectl -n openserverless delete pvc --all")

