import openserverless.config as cfg
import openserverless.util as util
import openserverless.runtimes_util as rutil
import openserverless.testutil as tu
import openserverless.kube as kube
import json
from collections import Counter

def cleanup():
    try:
        get_ipython().system("kubectl -n openserverless delete all --all")
        get_ipython().system("kubectl -n openserverless delete pvc --all")
    except NameError:
        import subprocess
        subprocess.run(["kubectl", "-n", "openserverless", "delete", "all", "--all"], check=True)
        subprocess.run(["kubectl", "-n", "openserverless", "delete", "pvc", "--all"], check=True)


cleanup()

# Test with Apache runtimes
assert(cfg.configure(tu.load_sample_config()))

runtimes_as_json = util.get_runtimes_json_from_config_map()
data=rutil.parse_runtimes(json.loads(runtimes_as_json))

assert(len(data['containers']) > 0), "Expected one or more containers in the preloader data"
for container in data['containers']:
    print(f"Container: {container['name']}, Image: {container['image']}")
    assert('name' in container), "Expected 'name' in container"
    assert('image' in container), "Expected 'image' in container"

# The configured catalog may include Apache, OpenWhisk or private images.
# Check the full selected catalog instead of assuming a registry organization.
expected=[]
for family,versions in json.loads(runtimes_as_json)['runtimes'].items():
    for runtime in versions:
        is_default=runtime.get('default',False)
        kind=runtime.get('kind','')
        if not (is_default or kind.endswith(':sys')):
            continue
        image=runtime['image']
        if not image.get('tag'):
            continue
        name=family if is_default else kind.replace(':','-').replace('.','-')
        expected.append((name,f"{image['prefix']}/{image['name']}:{image['tag']}"))
actual=[(container['name'],container['image']) for container in data['containers']]
assert Counter(actual)==Counter(expected), "Preloader containers must match default and system runtimes from the configured catalog"


cleanup()
